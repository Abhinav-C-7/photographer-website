---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import GalleryStrip from '../components/GalleryStrip.astro';
import Band from '../components/Band.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import { absolute } from '../lib/site';

const origin = absolute('/', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      url: origin,
      name: site.name,
      description: site.description,
    },
    {
      '@type': 'Photographer',
      '@id': `${origin}#photographer`,
      name: site.name,
      url: origin,
      description: site.description,
      image: absolute('/og-default.jpg', Astro.site),
      email: site.email,
      sameAs: [site.instagram],
      knowsAbout: ['Wedding photography'],
    },
  ],
};
---
<Base tone="light" jsonLd={jsonLd}>
  <Hero />
  <About />
  <GalleryStrip />
  <Band />
  <Services />
  <Contact />
</Base>
