---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { albums, details, site } from '../../data/site';
import { absolute, url } from '../../lib/site';

export function getStaticPaths() {
  return albums.map((album, i) => ({
    params: { slug: album.slug },
    props: { album, prev: albums[(i - 1 + albums.length) % albums.length], next: albums[(i + 1) % albums.length] },
  }));
}

const { album, prev, next } = Astro.props;
const path = `/albums/${album.slug}/`;
const title = `${album.couple} wedding at ${album.place} | ${site.name}`;
const description = `${album.summary} Wedding photographs of ${album.couple} by ${site.name}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ImageGallery',
      name: `${album.couple} wedding`,
      description,
      url: absolute(path, Astro.site),
      creator: { '@type': 'Photographer', name: site.name },
      dateCreated: String(album.year),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/', Astro.site) },
        { '@type': 'ListItem', position: 2, name: 'Gallery', item: absolute('/#gallery', Astro.site) },
        { '@type': 'ListItem', position: 3, name: album.couple, item: absolute(path, Astro.site) },
      ],
    },
  ],
};
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="album">
    <header class="wrap album__head">
      <nav aria-label="Breadcrumb"><a href={url('/#gallery')}>&larr; Gallery</a></nav>
      <h1>{album.couple}</h1>
      <p class="album__meta">{album.place} &middot; {album.year}</p>
      <p class="album__summary">{album.summary}</p>
    </header>

    <div class="wrap album__grid">
      {details.map((img, i) => (
        <Picture
          src={img}
          alt={`${album.couple} wedding photograph ${i + 1}`}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 40vw, 90vw"
          loading={i < 2 ? 'eager' : 'lazy'}
        />
      ))}
    </div>

    <nav class="wrap album__pager" aria-label="More albums">
      <a href={url(`/albums/${prev.slug}/`)}>&larr; {prev.couple}</a>
      <a href={url('/#contact')} class="btn">Check your date</a>
      <a href={url(`/albums/${next.slug}/`)}>{next.couple} &rarr;</a>
    </nav>
  </article>
</Base>

<style>
  .album { padding-top: 140px; }
  .album__head { max-width: 760px; margin-inline: auto; text-align: center; margin-bottom: 72px; }
  .album__head nav { text-align: left; font-size: 12px; margin-bottom: 56px; }
  .album__head nav a { text-decoration: none; }
  h1 { font-size: clamp(40px, 7vw, 84px); }
  .album__meta { font: 300 15px/1 var(--thin); letter-spacing: .3em; text-transform: uppercase; margin: 24px 0 28px; color: var(--ochre); }
  .album__summary { color: var(--muted); max-width: 520px; margin-inline: auto; }

  .album__grid { columns: 2; column-gap: clamp(14px, 2vw, 28px); }
  .album__grid :global(picture) { display: block; }
  .album__grid :global(img) { width: 100%; height: auto; margin-bottom: clamp(14px, 2vw, 28px); break-inside: avoid; }

  .album__pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 64px 0 96px; font-size: 13px; }
  .album__pager a:not(.btn) { text-decoration: none; }
  .album__pager a:not(.btn):hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .album__grid { columns: 1; }
    .album__pager { flex-direction: column; }
  }
</style>
