---
import { site } from '../data/site';
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div>
      <span class="index" aria-hidden="true">04</span>
      <h2 id="contact-title">Let&rsquo;s talk about your day.</h2>
      <p>
        Share your date and a little about the wedding. I reply personally, usually within a day or
        two.
      </p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagram} rel="noopener" target="_blank">@{site.instagramHandle} on Instagram</a></li>
      </ul>
    </div>

    <form action={site.formAction} method="POST">
      <label>Your names<input name="names" type="text" required autocomplete="name" /></label>
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <div class="row">
        <label>Wedding date<input name="date" type="date" /></label>
        <label>Venue or city<input name="venue" type="text" /></label>
      </div>
      <label>Tell me about your day<textarea name="message" rows="4" required></textarea></label>
      <button class="btn" type="submit">Send enquiry</button>
    </form>
  </div>
</section>

<style>
  .contact { padding: clamp(80px, 11vw, 150px) 0; }
  .contact__grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(40px, 7vw, 110px); }
  .contact .index { margin-bottom: 30px; }
  h2 { font-size: clamp(34px, 4.4vw, 52px); margin-bottom: 22px; }
  .contact__grid > div p { max-width: 380px; color: var(--muted); margin-bottom: 26px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  ul a { text-underline-offset: 4px; }

  form { display: grid; gap: 26px; align-content: start; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  label { display: grid; gap: 8px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  input, textarea {
    font: 400 15px/1.5 var(--sans); color: var(--ink); letter-spacing: 0; text-transform: none;
    background: transparent; border: 0; border-bottom: 1px solid var(--ink); padding: 8px 0; border-radius: 0;
  }
  input:focus, textarea:focus { outline: none; border-bottom-color: var(--ochre); }
  textarea { resize: vertical; }
  form .btn { justify-self: start; }
  @media (max-width: 760px) { .contact__grid { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; } }
</style>
